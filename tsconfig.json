{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "core/ai/**/*.cjs",
    "core/assets/**/*.cjs",
    "electron/asset-index.cjs",
    "electron/ai*.cjs",
    "electron/child-process.cjs",
    "electron/ipc/ai.cjs",
    "rendering/**/*.cjs",
    "workers/**/*.cjs",
    "electron/render*.cjs",
    "electron/verify-render.cjs",
    "electron/ipc/render.cjs",
    "core/audio/**/*.cjs",
    "electron/audio-service.cjs",
    "electron/ipc/audio.cjs"
  ],
  "exclude": ["node_modules"]
}
