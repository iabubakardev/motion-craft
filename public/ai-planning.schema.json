{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "planId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "sourceText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "fps": {
      "anyOf": [
        {
          "type": "number",
          "const": 24
        },
        {
          "type": "number",
          "const": 25
        },
        {
          "type": "number",
          "const": 30
        },
        {
          "type": "number",
          "const": 50
        },
        {
          "type": "number",
          "const": 60
        }
      ]
    },
    "timing": {
      "type": "string",
      "enum": ["estimated", "narration"]
    },
    "scenes": {
      "minItems": 1,
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sceneId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "narration": {
            "type": "string",
            "maxLength": 20000
          },
          "visualPrompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "searchKeywords": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "suggestedAssetType": {
            "type": "string",
            "enum": ["image", "video"]
          },
          "estimatedDurationFrames": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 5184000
          },
          "animationPreset": {
            "type": "string",
            "enum": [
              "fade-in",
              "fade-out",
              "slide-left",
              "slide-right",
              "slide-up",
              "slide-down",
              "zoom-in",
              "zoom-out",
              "pan",
              "pop-in",
              "documentary-zoom"
            ]
          }
        },
        "required": [
          "sceneId",
          "order",
          "narration",
          "visualPrompt",
          "searchKeywords",
          "suggestedAssetType",
          "estimatedDurationFrames"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["planId", "schemaVersion", "sourceText", "modelId", "fps", "timing", "scenes"],
  "additionalProperties": false
}
