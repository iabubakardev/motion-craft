{
  "name": "motion-craft",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",

  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:desktop": "concurrently -k \"npm run dev\" \"npm run electron:dev\"",
    "electron:dev": "wait-on http://localhost:3000 && cross-env ELECTRON_ENV=development electron .",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  }
}
